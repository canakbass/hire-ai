# Supabase Cloud Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI & External Integrations
GEMINI_API_KEY=your_gemini_api_key_here
VAPI_API_KEY=your_vapi_api_key_here

# n8n Webhook & Tunnel Configuration (Supabase Cloud -> n8n)
N8N_WEBHOOK_URL=https://your-tunnel-url.trycloudflare.com/webhook/hire-ai-cv-analyze
N8N_WEBHOOK_SECRET=your_super_secret_webhook_key_here

# Security / Rate Limiting (Edge Functions HMAC-SHA256 Salt)
RATE_LIMIT_SALT=replace_with_a_random_secret_salt_string
